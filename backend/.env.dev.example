# Django — development
DJANGO_SECRET_KEY=change-me-only-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — local development
POSTGRES_DB=audio_report
POSTGRES_USER=audio_report
POSTGRES_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0

# Docker Compose — optional host-side overrides
BACKEND_PORT=8000
POSTGRES_EXPOSE_PORT=5434
DOCKER_AI_API_URL=http://host.docker.internal:8800/generate-report/

# AI service
AI_API_URL=http://127.0.0.1:8800/generate-report/
AI_API_KEY=change-me
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=300

# Email — messages are printed to the development console
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dev@localhost
