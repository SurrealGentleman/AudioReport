# Django — production
DJANGO_SECRET_KEY=replace-with-a-long-unique-production-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# HTTPS security
DJANGO_SECURE_SSL_REDIRECT=True
# Enable these only after HTTPS works correctly on the domain and subdomains.
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

# PostgreSQL — production
POSTGRES_DB=audio_report
POSTGRES_USER=audio_report
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# AI service
AI_API_URL=https://ai.example.com/api/v2/reports/generate
AI_API_KEY=replace-with-the-production-ai-api-key
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=300

# Email — SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=reports@example.com
EMAIL_HOST_PASSWORD=replace-with-an-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=AudioReport <reports@example.com>
